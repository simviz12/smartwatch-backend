# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/pulso_db?schema=public

# Auth: secret used to sign session tokens (min 16 chars; Render generates one)
JWT_SECRET=temporary_placeholder_jwt_secret_min_32_chars_long

# Optional demo account created at startup
DEMO_EMAIL=profesor@pulso.app
DEMO_PASSWORD=cambia-esta-clave
DEMO_NAME=Profesor

# Optional (chat uses a mock LLM today)
LLM_API_KEY=temporary_placeholder_llm_api_key
LLM_CHAT_MODEL=gemini-1.5-flash
LLM_CLASSIFIER_MODEL=gemini-1.5-flash
